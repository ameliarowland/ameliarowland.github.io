<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Urban Trails Finder</title>
    <meta
      name="description"
      content="A Stadtwanderweg-inspired interactive web map prototype for curated urban walking loops in US cities."
    >
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIINfQmMdI0Z4h12p8mX0hgGcR31xQp8ROA="
      crossorigin=""
    >
    <link rel="stylesheet" href="/urban-trails-finder/styles.css">
  </head>
  <body>
    <main class="app-shell">
      <header class="app-header">
        <div>
          <p class="eyebrow">
            <a href="https://www.wien.gv.at/en/leisure/hiking-paths" target="_blank" rel="noopener noreferrer">Stadtwanderweg</a>-inspired GIS
          </p>
          <h1>Urban Trails Finder</h1>
        </div>
      </header>

      <aside class="sidebar" id="trailSidebar" aria-label="Urban trail controls">
        <div class="embed-panel-heading">
          <div>
            <p class="panel-number">Trail information</p>
            <h2>Explore urban trails</h2>
          </div>
          <button class="embed-panel-close" id="closeSidebarButton" type="button" aria-label="Close trail information" aria-controls="trailSidebar">
            <i data-lucide="x"></i>
          </button>
        </div>

        <div class="sidebar-content">

          <section class="filter-panel" aria-label="Trail filters">
          <label for="cityFilter">City</label>
          <select id="cityFilter">
            <option value="all">All cities</option>
          </select>
          </section>

          <section class="summary-grid" aria-label="Filtered trail summary">
          <div>
            <span id="trailCount">0</span>
            <small>routes</small>
          </div>
          <div>
            <span id="cityCount">0</span>
            <small>cities</small>
          </div>
          </section>

          <section class="selected-panel" aria-live="polite">
          <div class="selected-heading">
            <div>
              <p id="selectedCity" class="eyebrow">Select a route</p>
              <h2 id="selectedName">Route details</h2>
            </div>
          </div>
          <dl class="route-stats">
            <div>
              <dt>Distance</dt>
              <dd id="selectedDistance">--</dd>
            </div>
          </dl>
          <div class="action-row">
            <button id="downloadGpx" type="button" class="primary-action" disabled>
              <i data-lucide="download"></i>
              GPX
            </button>
            <button id="downloadKml" type="button" class="secondary-action" disabled>
              <i data-lucide="file-down"></i>
              KML
            </button>
            <button id="downloadGeoJson" type="button" class="secondary-action" disabled>
              <i data-lucide="braces"></i>
              GeoJSON
            </button>
          </div>
          </section>

          <section class="trail-list-section" aria-label="Trail results">
          <div class="list-heading">
            <h2>City Wander Paths</h2>
            <div class="list-actions" aria-label="Export visible trails">
              <button id="downloadAllGpx" type="button" class="text-button">
                <i data-lucide="archive"></i>
                GPX
              </button>
              <button id="downloadAllKml" type="button" class="text-button">
                <i data-lucide="file-archive"></i>
                KML
              </button>
              <button id="downloadAllGeoJson" type="button" class="text-button">
                <i data-lucide="braces"></i>
                GeoJSON
              </button>
            </div>
          </div>
          <div id="trailList" class="trail-list"></div>
          </section>

          <footer class="method-note">
            <strong>Data note:</strong> route geometry was generated from documented control points with Valhalla pedestrian routing over OpenStreetMap. Distances are calculated from that geometry. Routes are not field-verified or intended for turn-by-turn navigation.
          </footer>
        </div>
      </aside>

      <section class="map-panel" aria-label="Interactive trail map">
        <div id="map"></div>
        <div class="basemap-switcher" aria-label="Basemap choices">
          <button type="button" class="basemap-button is-active" data-basemap="Esri Topographic" aria-label="Esri Topographic basemap" aria-pressed="true" title="Esri Topographic">
            <span class="basemap-thumbnail basemap-topographic" aria-hidden="true"></span>
          </button>
          <button type="button" class="basemap-button" data-basemap="Esri Light Gray" aria-label="Esri Light Gray basemap" aria-pressed="false" title="Esri Light Gray">
            <span class="basemap-thumbnail basemap-light-gray" aria-hidden="true"></span>
          </button>
          <button type="button" class="basemap-button" data-basemap="Satellite" aria-label="Satellite basemap" aria-pressed="false" title="Satellite">
            <span class="basemap-thumbnail basemap-satellite" aria-hidden="true"></span>
          </button>
          <button type="button" class="basemap-button" data-basemap="OpenStreetMap" aria-label="OpenStreetMap basemap" aria-pressed="false" title="OpenStreetMap">
            <span class="basemap-thumbnail basemap-openstreetmap" aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <button class="embed-panel-open" id="openSidebarButton" type="button" aria-label="Open trail information" aria-controls="trailSidebar" aria-expanded="true">
        Trail information
      </button>
    </main>

    <script
      is:inline
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>
    <script is:inline src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script is:inline src="/urban-trails-finder/data.js"></script>
    <script is:inline src="/urban-trails-finder/app.js?v=20260831-8"></script>
  </body>
</html>
