---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolLink } from '../../data/tool-links';

export async function getStaticPaths() {
  const maps = await getCollection('maps', ({ data }) => !data.draft);
  return maps.map((map) => ({
    params: { slug: map.id },
    props: { map },
  }));
}

const { map } = Astro.props;
const { Content } = await render(map);
const { title, description, date, image, embedUrl, externalUrl, tallEmbed, tools, tags } = map.data;
const embedSrc = (() => {
  if (!embedUrl || !Astro.site) return embedUrl;

  const url = new URL(embedUrl);
  return url.origin === Astro.site.origin ? `${url.pathname}${url.search}${url.hash}` : embedUrl;
})();
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Amelia Rowland`} description={description} image={image}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 pt-16 pb-12">
    <a href="/maps" class="text-sm text-primary hover:text-primary-dark font-medium">← All maps</a>
    <h1 class="font-display text-3xl sm:text-4xl font-bold mt-4">{title}</h1>
    <p class="mt-3 text-text-muted">{description}</p>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-text-muted">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {tools.length > 0 && (
        <div class="flex items-center gap-1">
          <span aria-hidden="true">·</span>
          <ul class="flex flex-wrap" aria-label="Tools and technologies">
            {tools.map((tool, index) => {
              const toolLink = getToolLink(tool);
              return (
                <li>
                  {index > 0 && <span aria-hidden="true">,&nbsp;</span>}
                  {toolLink ? (
                    <a
                      href={toolLink}
                      target="_blank"
                      rel="noopener"
                      class="text-primary underline underline-offset-2 hover:text-primary-dark"
                    >
                      {tool}
                    </a>
                  ) : (
                    tool
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-8">
      {embedUrl ? (
        <iframe
          src={embedSrc}
          title={title}
          class:list={[
            'w-full rounded-xl border border-border',
            tallEmbed ? 'h-[78vh] min-h-[620px]' : 'aspect-[4/3]',
          ]}
          loading="lazy"
          allowfullscreen
        />
      ) : (
        <img src={image} alt={title} class="w-full rounded-xl border border-border" />
      )}
    </div>

    {externalUrl && (
      <p class="mt-4">
        <a
          href={externalUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center rounded-lg border border-primary px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          View map full screen ↗
        </a>
      </p>
    )}

    <div class="prose-map mt-8">
      <Content />
    </div>

    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mt-10 pt-6 border-t border-border">
        {tags.map((tag) => (
          <li class="text-xs px-2.5 py-1 rounded-full bg-surface border border-border text-text-muted">
            #{tag}
          </li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>
