<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Amtrak direct route explorer — Amelia Rowland</title>
<meta name="description" content="Explore Amtrak routes and stations, find direct destinations, and compare scheduled train travel times without transfers."/>
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.6.0/dist/maplibre-gl.css"/>
<link rel="stylesheet" href="/amtrak-direct-route-explorer/styles.css?v=amtrak-15"/>
</head>
<body>
<header><a href="/">Amelia Rowland <span>/ Maps &amp; data stories</span></a><a href="/maps/amtrak-direct-route-explorer/">About this map ↗</a></header>
<main>
<section class="intro"><div><p class="eyebrow">One train. Somewhere new.</p><h1>Amtrak <em>direct route explorer.</em></h1></div><p>Pick a station. See where one train can take you.<br/>Choose your destination to explore scheduled travel times.</p></section>
<section class="map-section" aria-label="Amtrak routes and stations">
<div id="map" aria-label="Interactive Amtrak map"></div>
<details id="journey-panel" open><summary>Plan a direct journey <svg class="panel-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div class="panel-content">
<form id="journey-form"><label for="start">Start station</label><div class="input-row"><input id="start" list="station-options" placeholder="City or station code" autocomplete="off"/><button type="button" id="clear-start" aria-label="Remove start station">×</button></div>
<button type="button" id="swap" class="text-button" aria-label="Swap start and end stations">⇅ Swap</button>
<label for="end">End station</label><div class="input-row"><input id="end" list="station-options" placeholder="City or station code" autocomplete="off"/><button type="button" id="clear-end" aria-label="Remove end station">×</button></div>
<datalist id="station-options"></datalist></form>
<p id="journey-status" role="status">Choose a station on the map or search above.</p><div id="journey-results"></div>
</div></details>
<div class="map-tools"><button id="clear-route" type="button" hidden>Clear route</button><button id="fit-journey" type="button" hidden>Fit journey ↗</button></div>
<div class="map-controls" role="group" aria-label="Map controls">
<button id="home" type="button" aria-label="Show the U.S. network" title="Show the U.S. network"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8M5 10v11h14V10M10 21v-7h4v7"/></svg></button>
<button id="toggle-stations" class="station-toggle" type="button" aria-pressed="false" title="Show or hide all stations"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2" width="14" height="16" rx="3"/><path d="M5 11h14M12 3v8M8 18l-3 4m11-4 3 4M7 21h10"/></svg>Stations</button>
<div class="basemap-buttons" role="group" aria-label="Basemap"><button type="button" data-basemap="positron" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 7h14M5 17h14"/></svg><span>Light</span></button><button type="button" data-basemap="fiord" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 7h14M5 17h14"/></svg><span>Dark</span></button></div>
<div class="zoom-buttons" role="group" aria-label="Map zoom"><button id="zoom-in" type="button" aria-label="Zoom in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg></button><button id="zoom-out" type="button" aria-label="Zoom out"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16"/></svg></button></div>
</div>
<p id="map-status" class="sr-only" role="status">Loading routes and timetable…</p>
<div id="route-name" hidden aria-live="polite"></div>
</section>
<footer><p id="source-note">Amtrak timetable snapshot · October 12–18, 2026 · Scheduled times, not live departures.</p><a href="/maps/amtrak-direct-route-explorer/">Method &amp; sources ↗</a></footer>
<noscript>This interactive map requires JavaScript. <a href="/maps/amtrak-direct-route-explorer/">Read about the data.</a></noscript>
</main>
<script is:inline src="https://unpkg.com/maplibre-gl@5.6.0/dist/maplibre-gl.js"></script><script is:inline type="module" src="/amtrak-direct-route-explorer/app.js?v=amtrak-15"></script>
</body></html>
